{
  "name": "dsh-purge",
  "version": "1.1.71",
  "description": "DeepSeek Harness 破甲 v1.1.71（镜像自 YuJunZhiXue/dsh-purge，上游已 404）。让所有模型都能破甲，不同模型可换不同提示词；默认提示词面向国模「小码酱」。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "presets",
    "skills",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kangyu087/dsh-purge.git"
  },
  "homepage": "https://github.com/kangyu087/dsh-purge#readme",
  "bugs": {
    "url": "https://github.com/kangyu087/dsh-purge/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/kangyu087/dsh-purge/archive/refs/heads/master.tar.gz",
      "zip": "https://github.com/kangyu087/dsh-purge/archive/refs/heads/master.zip",
      "git": "https://github.com/kangyu087/dsh-purge.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.1-rc.3",
  "upstream": {
    "repository": "https://github.com/YuJunZhiXue/dsh-purge",
    "name": "dsh-purge",
    "version": "1.1.71",
    "status": "unavailable (HTTP 404)",
    "license": "MIT",
    "note": "This repository is a mirror of dsh-purge v1.1.71. The upstream repository is no longer reachable; this copy preserves it for continued installation. All credit to the original author YuJunZhiXue. Non-commercial use only, per the upstream README attribution requirements."
  }
}